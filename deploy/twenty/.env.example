# Copy to `.env` in this directory (never commit real secrets).
# Upstream template: https://github.com/twentyhq/twenty/blob/main/packages/twenty-docker/.env.example

TAG=v2.1.0

# Strong password for Twenty's Postgres (avoid special characters that break URL parsing; see Twenty docs).
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password
PG_DATABASE_USER=postgres
PG_DATABASE_HOST=twenty-db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# Must match how you open the admin UI in the browser.
# With SSH local forward to the server (recommended): keep http://localhost:3000 on both laptop and SERVER_URL.
SERVER_URL=http://localhost:3000

REDIS_HOST=twenty-redis
REDIS_PORT=6379

# openssl rand -base64 32
APP_SECRET=replace_me_with_a_random_string

STORAGE_TYPE=local

# Optional S3 (leave empty for local storage; avoids compose unset-variable warnings).
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=

# You can override any PG/REDIS vars above if required.

# HikeConnect.Api (stage 4) should call Twenty inside Docker, e.g. base URL:
#   http://server:3000
# Do not use SERVER_URL from the API container; that value is for browser/OAuth/UI only.
