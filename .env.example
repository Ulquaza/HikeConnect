# DB
POSTGRES_DB=dbname
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Connection string
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=dbname;Username=username;Password=password

# JWT
JwtSettings__SecretKey=123456789012345678901234567890123456789
JwtSettings__Issuer=Issuer
JwtSettings__Audience=Audience
JwtSettings__AccessTokenExpirationMinutes=30
JwtSettings__RefreshTokenExpirationDays=7

# CORS
Cors__AllowedOrigins__0=http://your.website

# Twenty CRM (self-hosted). Контейнер api получает эти переменные из docker-compose.yml → см. сервис api.environment.
# BaseUrl — DNS/порт сервиса Twenty в общей сети hike_net (имя сервиса в compose Twenty, часто server → http://server:3000).
# ApiKey — Twenty → Settings → APIs & Webhooks (без ключа синхронизация отключена: IsConfigured = false).
Crm__Twenty__Enabled=true
Crm__Twenty__BaseUrl=http://server:3000
Crm__Twenty__ApiKey=
Crm__Twenty__GraphQlPath=graphql
Crm__Twenty__ObjectPluralName=behavioralleads
Crm__Twenty__CreateInputTypeName=BehavioralLeadCreateInput
# Если имя мутации в Twenty не совпадает с автогенерацией (createMany + Capitalize(ObjectPluralName)), задайте явно:
# Crm__Twenty__CreateManyMutationName=createManyBehavioralLeads
#
# --- Сверка схемы GraphQL (Twenty 2.x) перед продом ---
# 1) В Twenty UI откройте GraphQL / API explorer для workspace или запросите список мутаций:
#    query { __schema { mutationType { fields { name } } } }
# 2) Убедитесь, что есть мутация вида createMany* для вашего объекта и тип входа CreateInput совпадает с CreateInputTypeName.
# 3) Имена полей в теле записи в коде — camelCase (TwentyCrmClient): sourceUserId, sourceProfileId, email, fullName,
#    riskTolerance, pacingStyle, disciplineLevel, conflictStrategy, profileUpdatedAt — они должны совпадать с API-именами полей объекта в Twenty.
# При ошибках смотрите логи api: «Twenty CRM GraphQL error» / «CRM sync failed».
